# App & Environment
NODE_ENV=development
PORT=3000
SITE_URL=https://neadrdeath.ir
NEXT_PUBLIC_SITE_URL=https://neadrdeath.ir
SITE_NAME=مرز آگاهی
DEFAULT_LOCALE=fa
SUPPORTED_LOCALES=fa

# Payload & Security Secrets
PAYLOAD_SECRET=your_32_character_payload_secret_here_random_hash
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IP_HASH_SALT=your_random_salt_for_rate_limiting_ip_hashes

# Cloudflare Account & Bindings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 Storage (or Local Mock)
R2_PUBLIC_BUCKET=marzeagahi-public
R2_PRIVATE_BUCKET=marzeagahi-private
R2_QUARANTINE_BUCKET=marzeagahi-quarantine
R2_PUBLIC_BASE_URL=https://media.neadrdeath.ir

# Cloudflare Stream (or Local Mock)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Cloudflare Turnstile (Spam & Bot Protection)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email Configuration (Default: none / NoopEmailProvider)
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@neadrdeath.ir
ADMIN_NOTIFICATION_EMAIL=admin@neadrdeath.ir

# Analytics & Observability (Disabled by default)
ANALYTICS_ENABLED=false
SENTRY_DSN=
