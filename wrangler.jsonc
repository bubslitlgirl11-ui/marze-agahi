{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marze-agahi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marzeagahi-d1-prod",
      "database_id": "b1e8774c-80ec-4d47-aae7-5c72636074c3"
    }
  ],
  "vars": {
    "SITE_URL": "https://neadrdeath.ir",
    "DEFAULT_LOCALE": "fa",
    "EMAIL_PROVIDER": "none",
    "ANALYTICS_ENABLED": "false"
  }
}
